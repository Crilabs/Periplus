# Copy to .env.local for development. Never commit real values.

# Database (docker/compose.dev.yml)
DATABASE_URL=postgres://periplus:periplus@localhost:5433/periplus
TEST_DATABASE_URL=postgres://periplus:periplus@localhost:5434/periplus_test

# Admin session (min. 32 random bytes, e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Archive (SeaweedFS locally, Hetzner Object Storage in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=periplus-archive
S3_ACCESS_KEY_ID=periplus
S3_SECRET_ACCESS_KEY=periplus-dev-secret

# External services
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# Contact address in the crawler User-Agent and for Overpass/Nominatim
CONTACT_EMAIL=
