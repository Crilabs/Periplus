# Simulated revisit (spec 10, plan Task 15): copy to .env.sim after `npm run sim:clone`. Never commit real values.
# The sim worker and every sim CLI read only this file (`npm run sim:worker`, `sim:draft-scenario`, `sim:revisit`,
# `sim:verify` use `tsx --env-file=.env.sim`), so they share one scenario, database and archive prefix. Copy the
# remaining values (session secret, S3 access, API keys, contact address) from .env.local.
# The sim web (asOf check, packages of the simulation) runs from its own git worktree, never as a second `next dev`
# in this folder: Next 16 locks `.next/dev/lock` per project and refuses a second dev server (ruling M7-H-R1). In the
# worktree this file becomes its .env.local (run book docs/pilot/m7-runbook.md, „Simulations-Web“):
#   git worktree add ../periplus-sim HEAD && cd ../periplus-sim && npm ci
#   cp ../periplus/.env.sim .env.local && mkdir -p data/sim && cp ../periplus/data/sim/scenario.json data/sim/
#   npm run build && npx next start -p 3001
# Afterwards: git worktree remove ../periplus-sim.
# Rulings M7-P27: stop the development worker during the clone; no development text run while the sim worker runs
# (same Anthropic key); afterwards `dropdb periplus_sim` and delete the archive objects under the prefix.

# Database (docker/compose.dev.yml)
DATABASE_URL=postgres://periplus:periplus@localhost:5433/periplus_sim
TEST_DATABASE_URL=postgres://periplus:periplus@localhost:5434/periplus_test

# Admin session (min. 32 random bytes, e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Archive (SeaweedFS locally, Hetzner Object Storage in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=periplus-archive
S3_TEST_BUCKET=periplus-test
S3_ACCESS_KEY_ID=periplus
S3_SECRET_ACCESS_KEY=periplus-dev-secret

# External services
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# Contact address in the crawler User-Agent and for Overpass/Nominatim
CONTACT_EMAIL=

# Page rendering in the worker: playwright (default; needs Chromium) or off (render: auto/always never render)
PERIPLUS_RENDERER=playwright

# sim:verify --base-url: the delivery:read key created in the simulation (run book step 5); never pass it as --key
PERIPLUS_API_KEY=

# Navily spot file for the comparison on /quality/compare and compare:navily; read at runtime only, never stored
NAVILY_SPOTS_PATH=

# Simulated revisit: the scenario file (real pilot scenarios live under the git-ignored data/sim/); the process then
# runs only against periplus_sim or *_test and reaches no external service except Anthropic and Voyage.
PERIPLUS_SIMULATION=data/sim/scenario.json
# Archive writes of the simulation go under this prefix: replace YYYYMMDD by the clone date (lower-case, ending in /)
S3_WRITE_PREFIX=sim/YYYYMMDD/
