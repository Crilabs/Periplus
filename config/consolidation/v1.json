{
  "recency": { "halfLifeYears": 3 },
  "precision": 3,
  "weights": { "computed": 1.0, "review": 1.0, "observed": 0.8, "poi": 0.6 },
  "poiConfidence": 0.6,
  "confidence": {
    "secondSourceBonus": 0.15,
    "cap": 0.95,
    "review": 0.95,
    "classes": [
      { "name": "high", "min": 0.7 },
      { "name": "medium", "min": 0.4 },
      { "name": "low", "min": 0 }
    ]
  },
  "conflict": { "minRatio": 1.5 },
  "change": { "minIndependent": 2, "strongWeight": 0.8 },
  "expiry": { "cycles": 2, "defaultCycleDays": 365 },
  "rules": {
    "shelter": {
      "maxCorrection": 0.3,
      "harbourFloor": 0.8,
      "harbourKinds": ["port", "marina"],
      "openSideMinConfidence": 0.7,
      "openSideMaxValue": 0.5,
      "harbourDefaultConfidence": 0.3
    },
    "swell_protection": { "textMinConfidence": 0.7 },
    "bathymetry": { "textMinConfidence": 0.8, "weakRasterConfidence": 0.4 },
    "latest_observation": { "presence": ["mooring.buoys"] },
    "default": { "latestMinConfidence": 0.5, "fieldwise": ["contact"] },
    "area_weighted": { "agreeWithin": 0.2 },
    "highlight": { "maxNames": 10, "poiRadiusM": 2000 },
    "union": {
      "keys": {
        "hazards": ["kind", "name"],
        "restricted_zones": ["kind", "name"],
        "wind_systems": ["name"],
        "season_notes": ["kind"],
        "mooring.types": [],
        "charter_bases": [],
        "supply_ports": []
      }
    }
  },
  "profileConfidence": { "shelter": 0.4, "depth": 0.25, "seabed": 0.2, "exclude": 0.15 },
  "quietness": {
    "settlementFullM": 2000,
    "roadFullM": 1000,
    "ferryLaneRadiusM": 2000,
    "ferryLaneValue": 0.3,
    "occupancyMonths": [7, 8],
    "occupancy": { "empty": 1, "moderate": 0.5, "full": 0 },
    "text": { "quiet": 1, "moderate": 0.6, "busy": 0.3, "noisy": 0 },
    "ferryTraffic": { "none": 1, "low": 0.8, "moderate": 0.5, "high": 0.2 },
    "weights": { "settlement": 0.3, "road": 0.2, "occupancy": 0.2, "text": 0.2, "ferry": 0.1 }
  },
  "importance": {
    "sitelinksPerPoint": 10,
    "maxSitelinkPoints": 2,
    "categoryBonus": { "food": 0, "supply": 0, "beach": 0.5, "nature": 0.5, "active": 0.5, "culture": 1, "town": 1 },
    "thresholds": [1, 2, 3.5, 5],
    "radiusNm": [5, 10, 20, 35, 50],
    "maxSpotIds": 50
  },
  "severity": {
    "safety": ["exclude", "max_draft", "max_length", "hazards", "prohibitions", "depth.*"],
    "shelterDelta": 0.2,
    "notable": ["services.*", "highlight.*", "occupancy", "mooring.buoys"]
  },
  "gaps": { "ignore": { "anchorage": ["contact", "prices", "capacity"], "mooring_field": ["contact"] } },
  "followup": { "minDocuments": 2, "cooldownDays": 90, "maxPlacesPerRun": 30 },
  "summary": { "levels": ["place", "poi"], "sentences": { "place": [2, 4], "poi": [1, 2] }, "maxAttempts": 3, "lowConfidence": 0.3 }
}
