      { "typeName": "emodnet:finfish", "kind": "aquaculture", "bufferM": 250, "idField": "gid" },
      { "typeName": "emodnet:shellfish", "kind": "aquaculture", "bufferM": 250, "idField": "id" }
    ],
    "pageSize": 1000,
    "timeoutSeconds": 180,
    "ratePerMinute": 20
  },
  "vesselDensity": {
