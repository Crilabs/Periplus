      "Muddy sand": "sand",
      "Sand": "sand",
      "SAND": "sand",
      "Coarse substrate": "gravel",
      "Mixed sediment": "mixed",
      "Coarse & mixed sediment": "mixed",
      "Rock or other hard substrata": "rock"
    },
    "weedPatterns": ["posidonia", "seagrass", "cymodocea", "zostera"],
