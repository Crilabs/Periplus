{
  "schemaVersion": "4.0",
  "build": { "lockTimeoutMs": 300000 },
  "spots": { "statuses": ["confirmed", "no_anchoring"], "maxSources": 20, "excludedFallbackName": "Ankerplatz ohne Namen" },
  "coast": {
    "marginNm": 2,
    "simplifyToleranceM": 10,
    "source": "OpenStreetMap, ODbL",
    "restrictedSourceDefault": "EMODnet Human Activities"
  },
  "regions": {
    "types": ["island", "archipelago", "coast_section", "gulf", "channel"],
    "pointRadiusNm": 2,
    "memberMarginNm": 0.5,
    "simplifyToleranceM": 50
  },
  "weather": { "regionBufferNm": 3, "regionMinWaterShare": 0.05, "capeOffsetNm": 1, "capeLandRadiusM": 2000 },
  "radius": { "nmPerDay": 50, "returnFactor": 0.5, "minDays": 1, "maxDays": 28 },
  "validation": {
    "maxWaterDistanceNm": 1.5,
    "spotDuplicateM": 150,
    "highlightDuplicateM": 500,
    "maxDraftM": [0.5, 10],
    "maxLengthM": [5, 100],
    "harbourMinShelter": 0.8,
    "harbourShelterSources": ["text", "observed", "review"],
    "maxCopiedWords": 15,
    "domainTlds": ["com", "net", "org", "gr", "de", "it", "fr", "es", "hr", "tr", "eu", "info", "io", "co", "uk"],
    "copyCheckConcurrency": 4,
    "lowConfidence": 0.3,
    "lowConfidenceNote": "wenig belegt"
  },
  "forbiddenDomains": ["navily.com", "google.*", "goo.gl", "g.co", "g.page", "googleusercontent.com", "googleapis.com", "gstatic.com", "ggpht.com"],
  "licenses": [
    {
      "name": "ODbL-1.0",
      "attribution": "© OpenStreetMap contributors",
      "url": "https://opendatacommons.org/licenses/odbl/1-0/",
      "files": ["coast.geojson"],
      "fields": [
        "spots.json#/spots/*/name",
        "spots.json#/spots/*/names",
        "spots.json#/spots/*/externalRefs/osmId",
        "spots.json#/spots/*/nearby/*/name",
        "spots.json#/spots/*/nearby/*/names",
        "regions.json#/regions/*/name",
        "regions.json#/regions/*/names",
        "regions.json#/regions/*/polygon"
      ]
    },
    {
      "name": "CC-BY-3.0",
      "attribution": "Luftbild © Hellenic Cadastre (CC BY 3.0)",
      "url": "https://creativecommons.org/licenses/by/3.0/",
      "files": [],
      "fields": ["spots.json#/spots/*/images"]
    },
    {
      "name": "CC-BY-4.0",
      "attribution": "Sentinel-2 cloudless 2016 © EOX (CC BY 4.0)",
      "url": "https://creativecommons.org/licenses/by/4.0/",
      "files": [],
      "fields": ["spots.json#/spots/*/images"]
    },
    {
      "name": "Copernicus-DEM",
      "attribution": "Gelände © DLR/Airbus, Copernicus",
      "url": "https://spacedata.copernicus.eu/collections/copernicus-digital-elevation-model",
      "files": [],
      "fields": ["spots.json#/spots/*/images"]
    }
  ],
  "api": { "cacheMaxAgeSeconds": 60 },
  "confirmation": {
    "aloneTypes": ["pilot_guide", "authority"],
    "pairTypes": ["trip_report", "forum", "travel_guide", "other"],
    "pairMinDomains": 2,
    "ownSiteTypes": ["marina"],
    "berthAttributes": [
      "berthable",
      "mooring.types",
      "mooring.buoys",
      "mooring.line_ashore_required",
      "depth.anchoring_min",
      "depth.anchoring_max",
      "seabed",
      "holding",
      "shelter.*"
    ],
    "routeStops": true
  }
}
