{
  "serp": {
    "endpoint": "https://api.dataforseo.com/v3/serp/google/organic/live/regular",
    "depth": 20,
    "reuseDays": 30,
    "maxQueriesPerRun": 240,
    "costPerQueryEur": 0.0035,
    "ratePerMinute": 30,
    "timeoutMs": 120000,
    "taskRetries": 3,
    "taskRetryDelayMs": 5000
  },
  "bay": { "minAnchorAreaM2": 20000, "minWikidataNames": 2 },
  "placeWebsite": {
    "templates": [
      { "template": "{name} marina", "lang": "en", "locationCode": 2826 },
      { "template": "{name} {island} marina", "lang": "en", "locationCode": 2826 },
      { "template": "μαρίνα {name}", "lang": "el", "locationCode": 2300 }
    ],
    "maxResults": 5,
    "retryDays": 180,
    "minConfidence": 0.8,
    "crawl": { "maxDepth": 2, "maxPagesPerStartUrl": 30 }
  },
  "proposals": {
    "ignoreDomains": [
      "navily.com",
      "google.com",
      "youtube.com",
      "facebook.com",
      "instagram.com",
      "pinterest.com",
      "wikipedia.org",
      "tripadvisor.com",
      "tripadvisor.de",
      "tripadvisor.co.uk",
      "booking.com",
      "amazon.com",
      "amazon.de"
    ],
    "typeHints": [
      { "pattern": "(forum|viewtopic|showthread|thread|board)", "type": "forum" },
      { "pattern": "(gov\\.gr|hnhs|hcg\\.gr|ypa\\.gr|limenarxeio)", "type": "authority" },
      { "pattern": "(marina|harbou?r|port-of)", "type": "marina" },
      { "pattern": "\\.pdf$", "type": "pilot_guide" },
      { "pattern": "(pilot|guide|revierf)", "type": "pilot_guide" },
      { "pattern": "(/20\\d{2}/|blog|log|toern|törn|reise|trip)", "type": "trip_report" }
    ],
    "defaultType": "trip_report"
  }
}
