  "geonames": {
    "baseUrl": "https://download.geonames.org/export/dump",
    "featureCodes": {
      "BAY": "bay",
      "BAYS": "bay",
      "COVE": "bay",
      "INLT": "bay",
      "CAPE": "cape",
      "PT": "cape",
      "ISL": "island",
      "ISLET": "islet",
      "ISLS": "archipelago",
      "STRT": "strait",
      "CHN": "channel",
      "PRT": "harbour",
      "MAR": "harbour",
