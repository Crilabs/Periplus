  "bboxBufferKm": 5,
  "landBufferKm": 55,
  "coastDistanceM": 2000,
  "poiCoastDistanceKm": 20,
  "coarse": { "placeTypes": ["city", "town"], "islandMinAreaKm2": 1, "gulfMinAreaKm2": 20, "coastDistanceKm": 5 },
