    "languages": ["de", "en", "el", "it", "hr"],
    "classes": {
      "Q23442": "island",
      "Q207524": "islet",
      "Q33837": "archipelago",
      "Q39594": "bay",
      "Q185113": "cape",
      "Q37901": "strait",
      "Q44782": "harbour",
      "Q486972": "settlement",
      "Q839954": "poi",
      "Q44613": "poi",
      "Q39715": "poi",
      "Q33506": "poi",
      "Q40080": "poi"
    },
    "ratePerMinute": 10
