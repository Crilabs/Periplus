{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "periplus:contract/1.0/highlights.schema.json",
  "title": "Periplus Data Contract 1.0 – highlights.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "area": {
      "type": "string",
      "pattern": "^ar_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hl_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "food",
              "supply",
              "beach",
              "nature",
              "active",
              "culture",
              "town",
              "quiet"
            ]
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "position": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Decimal degrees (WGS84) with at most 5 decimals"
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Decimal degrees (WGS84) with at most 5 decimals"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          },
          "spotIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sp_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "regionId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^rg_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "season": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "months": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    }
                  }
                },
                "required": [
                  "months"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "object",
            "properties": {
              "de": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "de"
            ],
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "pilotGuide",
                    "tripReport",
                    "forum",
                    "marina",
                    "authority",
                    "dataset",
                    "travelGuide",
                    "other"
                  ]
                },
                "observedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                }
              },
              "required": [
                "url",
                "kind",
                "observedAt"
              ],
              "additionalProperties": false
            }
          },
          "externalRefs": {
            "type": "object",
            "properties": {
              "googlePlaceId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{10,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "osmId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(node|way|relation)\\/\\d+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wikidataId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^Q\\d+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "googlePlaceId",
              "osmId",
              "wikidataId"
            ],
            "additionalProperties": false
          },
          "score": {
            "type": "object",
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sourcesCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastObserved": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "confidence",
              "sourcesCount",
              "lastObserved"
            ],
            "additionalProperties": false
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Version of the contract object; rises only when the delivered object changes. Compare versions within one area's feed only: an object moved to another area keeps counting there, and the old area's removal may carry a higher version than the new area's live object"
          },
          "validFrom": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "importance",
          "position",
          "spotIds",
          "season",
          "score",
          "profileVersion",
          "validFrom"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "area",
    "dataVersion",
    "generatedAt",
    "highlights"
  ],
  "additionalProperties": false
}
