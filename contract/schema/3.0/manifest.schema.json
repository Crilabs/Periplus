{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "periplus:contract/3.0/manifest.schema.json",
  "title": "Periplus Data Contract 3.0 – manifest.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3.0"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "subdivision"
            },
            "subdivision": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^sd_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lang": {
                        "type": "string",
                        "minLength": 2
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "lang",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "polygon": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "Polygon"
                        },
                        "coordinates": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "minItems": 4,
                            "type": "array",
                            "items": {
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180,
                                  "description": "Decimal degrees (WGS84) with at most 5 decimals"
                                },
                                {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90,
                                  "description": "Decimal degrees (WGS84) with at most 5 decimals"
                                }
                              ],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2
                            }
                          }
                        }
                      },
                      "required": [
                        "type",
                        "coordinates"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "MultiPolygon"
                        },
                        "coordinates": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "minItems": 4,
                              "type": "array",
                              "items": {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number",
                                    "minimum": -180,
                                    "maximum": 180,
                                    "description": "Decimal degrees (WGS84) with at most 5 decimals"
                                  },
                                  {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90,
                                    "description": "Decimal degrees (WGS84) with at most 5 decimals"
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "type",
                        "coordinates"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "key",
                "name",
                "names",
                "polygon"
              ],
              "additionalProperties": false
            },
            "dataVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "previousDataVersion": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "subdivision",
            "dataVersion",
            "previousDataVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radius"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "homeMarina": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^sp_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "center": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90,
                  "description": "Decimal degrees (WGS84) with at most 5 decimals"
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "description": "Decimal degrees (WGS84) with at most 5 decimals"
                }
              },
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 28
            },
            "radiusNm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "circle": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "Polygon"
                },
                "coordinates": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "minItems": 4,
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180,
                          "description": "Decimal degrees (WGS84) with at most 5 decimals"
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90,
                          "description": "Decimal degrees (WGS84) with at most 5 decimals"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "key",
            "homeMarina",
            "center",
            "days",
            "radiusNm",
            "circle"
          ],
          "additionalProperties": false
        }
      ]
    },
    "coverage": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sd_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "delivered",
              "missing"
            ]
          },
          "dataVersion": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "status",
          "dataVersion"
        ],
        "additionalProperties": false
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ar_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string",
                  "minLength": 2
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "lang",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "key",
          "names"
        ],
        "additionalProperties": false
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Decimal degrees (WGS84) with at most 5 decimals"
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Decimal degrees (WGS84) with at most 5 decimals"
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Decimal degrees (WGS84) with at most 5 decimals"
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Decimal degrees (WGS84) with at most 5 decimals"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q025:\\d+:\\d+$"
          },
          "lastRunAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "profilesAsOf": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "lastRunAt",
          "profilesAsOf"
        ],
        "additionalProperties": false
      }
    },
    "objectCounts": {
      "type": "object",
      "properties": {
        "spots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "highlights": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weatherPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coastFeatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "spots",
        "highlights",
        "regions",
        "weatherPoints",
        "coastFeatures",
        "changes"
      ],
      "additionalProperties": false
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "manifest.json",
                "spots.json",
                "highlights.json",
                "regions.json",
                "coast.geojson",
                "weather-points.json",
                "changes.json"
              ]
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "attribution",
          "url",
          "files",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "manifest.json",
                  "spots.json",
                  "highlights.json",
                  "regions.json",
                  "coast.geojson",
                  "weather-points.json",
                  "changes.json"
                ]
              },
              {
                "type": "string",
                "pattern": "^images\\/(?:sp|hl)_[0-9A-HJKMNP-TV-Z]{26}-(?:title|view-[1-9]\\d*)\\.jpg$"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "coverage",
    "areas",
    "generatedAt",
    "bbox",
    "tiles",
    "objectCounts",
    "licenses",
    "files"
  ],
  "additionalProperties": false
}
