{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "periplus:contract/3.0/regions.schema.json",
  "title": "Periplus Data Contract 3.0 – regions.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3.0"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "subdivision"
            },
            "id": {
              "type": "string",
              "pattern": "^sd_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "dataVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "id",
            "dataVersion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radius"
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rg_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lang": {
                  "type": "string",
                  "minLength": 2
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "lang",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "island",
              "coast",
              "gulf",
              "channel",
              "archipelago"
            ]
          },
          "center": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Decimal degrees (WGS84) with at most 5 decimals"
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Decimal degrees (WGS84) with at most 5 decimals"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          },
          "radiusNm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "polygon": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 4,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180,
                            "description": "Decimal degrees (WGS84) with at most 5 decimals"
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90,
                            "description": "Decimal degrees (WGS84) with at most 5 decimals"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "MultiPolygon"
                  },
                  "coordinates": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "minItems": 4,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180,
                              "description": "Decimal degrees (WGS84) with at most 5 decimals"
                            },
                            {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90,
                              "description": "Decimal degrees (WGS84) with at most 5 decimals"
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "additionalProperties": false
              }
            ]
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^rg_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "spotIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sp_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "character": {
            "type": "object",
            "properties": {
              "de": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "de"
            ],
            "additionalProperties": false
          },
          "facts": {
            "type": "object",
            "properties": {
              "meltemiExposure": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ferryTraffic": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "none",
                      "light",
                      "heavy"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "charterBase": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "supplyPort": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "meltemiExposure",
              "ferryTraffic",
              "charterBase",
              "supplyPort"
            ],
            "additionalProperties": false
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Version of the contract object; rises only when the delivered object changes. Compare versions within one subdivision's feed only: an object moved to another subdivision keeps counting there, and the old subdivision's removal may carry a higher version than the new subdivision's live object"
          },
          "validFrom": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "center",
          "radiusNm",
          "parentId",
          "spotIds",
          "profileVersion",
          "validFrom"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "generatedAt",
    "regions"
  ],
  "additionalProperties": false
}
