# Site block for the server's own Caddy (systemd, shared with other apps). bootstrap.sh installs it as
# /etc/caddy/periplus.caddy and imports it from /etc/caddy/Caddyfile; after a change copy it there and
# `systemctl reload caddy`.
periplus.marvoy.app {
	# The login rate limit takes the leftmost X-Forwarded-For entry. That is only the client address while Caddy
	# overwrites the header for every peer it does not trust. The server's global trusted_proxies lists only the
	# Cloudflare ranges (for other sites); this domain does not go through Cloudflare, so only a request coming from
	# a Cloudflare address keeps its header. Never widen that list.

	# Request bodies are limited here, before the web server buffers them (SEC-1): 1 MB everywhere (login, admin
	# forms, the delivery API).
	request_body {
		max_size 1MB
	}

	# compose.prod.yml publishes web on loopback only.
	reverse_proxy 127.0.0.1:3500

	log {
		output file /var/log/caddy/periplus.log {
			roll_size 10mb
			roll_keep 10
		}
	}
}
