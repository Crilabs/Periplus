{
  "name": "periplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "services:up": "docker compose -f docker/compose.dev.yml up -d --build",
    "services:down": "docker compose -f docker/compose.dev.yml down",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ops": "bash scripts/deploy/__tests__/deploy-test.sh",
    "worker": "tsx watch --env-file-if-exists=.env.local worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/user.ts create",
    "user:password": "tsx --env-file-if-exists=.env.local scripts/user.ts password",
    "user:disable": "tsx --env-file-if-exists=.env.local scripts/user.ts disable",
    "apikey:revoke": "tsx --env-file-if-exists=.env.local scripts/apikey.ts revoke",
    "apikey:create": "tsx --env-file-if-exists=.env.local scripts/apikey.ts create",
    "import:land-polygons": "tsx --env-file-if-exists=.env.local scripts/import-land-polygons.ts",
    "check:gazetteer": "tsx --env-file-if-exists=.env.local scripts/check-gazetteer.ts",
    "fixtures:record": "tsx --env-file-if-exists=.env.local scripts/fixtures-record.ts",
    "smoke:ai": "tsx --env-file-if-exists=.env.local scripts/smoke-ai.ts",
    "compare:navily": "tsx --env-file-if-exists=.env.local scripts/compare-navily.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shapefile": "^0.6.6",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
