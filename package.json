{
  "name": "periplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "services:up": "docker compose -f docker/compose.dev.yml up -d --build",
    "services:down": "docker compose -f docker/compose.dev.yml down",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ops": "bash scripts/deploy/__tests__/deploy-test.sh",
    "worker": "tsx watch --env-file-if-exists=.env.local worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "user:create": "tsx --env-file-if-exists=.env.local scripts/user.ts create",
    "user:password": "tsx --env-file-if-exists=.env.local scripts/user.ts password",
    "user:disable": "tsx --env-file-if-exists=.env.local scripts/user.ts disable",
    "apikey:revoke": "tsx --env-file-if-exists=.env.local scripts/apikey.ts revoke",
    "apikey:create": "tsx --env-file-if-exists=.env.local scripts/apikey.ts create",
    "import:land-polygons": "tsx --env-file-if-exists=.env.local scripts/import-land-polygons.ts",
    "check:gazetteer": "tsx --env-file-if-exists=.env.local scripts/check-gazetteer.ts",
    "check:geometry": "tsx --env-file-if-exists=.env.local scripts/check-geometry.ts",
    "smoke:ai": "tsx --env-file-if-exists=.env.local scripts/smoke-ai.ts",
    "research:gate": "tsx --env-file-if-exists=.env.local scripts/research-gate.ts",
    "compare:navily": "tsx --env-file-if-exists=.env.local scripts/compare-navily.ts",
    "archive:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-archive.ts",
    "contract:generate": "tsx scripts/contract-generate.ts",
    "delivery:consume": "tsx --env-file-if-exists=.env.local scripts/delivery-consume.ts",
    "pois:reclassify": "tsx --env-file-if-exists=.env.local scripts/reclassify-pois.ts",
    "areas:import": "tsx --env-file-if-exists=.env.local scripts/import-areas.ts",
    "migrate:subdivisions": "tsx --env-file-if-exists=.env.local scripts/migrate-subdivisions.ts",
    "check:subdivision-migration": "tsx scripts/check-subdivision-migration.ts",
    "images:scene": "tsx scripts/build-render-scene.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "franc": "^6.2.0",
    "geotiff": "^3.0.5",
    "jose": "^6.2.12",
    "linkedom": "^0.18.13",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "playwright": "1.64",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robots-parser": "^3.0.1",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "tldts": "^7.4.18",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "ulid": "^3.0.2",
    "undici": "^7.30.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@types/three": "^0.186.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
